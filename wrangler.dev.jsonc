{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pgt-github-probe-dev",
  "main": "worker/dev.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "DATA_BRANCH": "main",
    "FIRESTORE_PROJECT_ID": "pgt-bjj-dev",
    "FIRESTORE_DATABASE_ID": "(default)",
    "ALLOWED_ORIGINS": "https://pgt-github-probe-dev.david-dzm5.workers.dev",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "services": [{ "binding": "DOMAIN_IO", "service": "pgt-github-probe-dev", "entrypoint": "DomainIO" }],
  "durable_objects": {
    "bindings": [{ "name": "SECURITY", "class_name": "ProbeSecurity" }],
  },
  "migrations": [
    { "tag": "github-probe-dev-v1", "new_sqlite_classes": ["ProbeSecurity"] },
  ],
}
