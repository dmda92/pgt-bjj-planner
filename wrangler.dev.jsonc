{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pgt-github-probe-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "DATA_BRANCH": "main",
    "ALLOWED_ORIGINS": "https://pgt-github-probe-dev.david-dzm5.workers.dev",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "SECURITY", "class_name": "ProbeSecurity" }],
  },
  "migrations": [
    { "tag": "github-probe-dev-v1", "new_sqlite_classes": ["ProbeSecurity"] },
  ],
}
