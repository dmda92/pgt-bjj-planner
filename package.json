{
  "name": "pgt-bjj-planner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:performance": "node scripts/benchmark-trainer.mjs",
    "test:runtime": "node scripts/test-runtime.mjs && node scripts/test-app-runtime.mjs && node scripts/test-plan-recovery-runtime.mjs",
    "build": "vite build && node scripts/finalize-pwa.mjs",
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "check:worker": "node scripts/check-worker.mjs",
    "deploy:worker": "wrangler deploy",
    "test:browser": "node scripts/test-browser.mjs && node scripts/test-trainer-cache.mjs && node scripts/test-qa-recovery.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "miniflare": "^5.20261006.2-beta",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "dexie": "4.4.6",
    "jspdf": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
