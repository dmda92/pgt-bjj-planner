{
  "name": "pgt-bjj-planner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:performance": "node scripts/benchmark-trainer.mjs",
    "test:runtime": "node scripts/test-firestore-v2-runtime.mjs && node scripts/test-v2-app-runtime.mjs && node scripts/test-v2-recovery-runtime.mjs && node scripts/test-v2-session-runtime.mjs",
    "build": "vite build && node scripts/finalize-pwa.mjs",
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "check:worker": "node scripts/check-worker.mjs",
    "deploy:worker": "wrangler deploy",
    "test:browser": "node scripts/test-v2-browser.mjs",
    "test:qa-remediation": "node --experimental-strip-types node_modules/@playwright/test/cli.js test --config=qa/remediation/playwright.config.mjs",
    "test:v2": "node --experimental-strip-types --test tests/native-packing.test.ts tests/plan-codec.test.ts tests/plan-text-projection.test.ts tests/trainer-agenda-v2.test.ts tests/version-cache.test.ts tests/v2-*.test.ts",
    "check:firestore-v2": "node scripts/check-firestore-v2.mjs",
    "benchmark:firestore-v2": "node --experimental-strip-types scripts/benchmark-firestore-v2.mjs && node --experimental-strip-types scripts/benchmark-v2-application.mjs",
    "test:v2:runtime": "node --experimental-strip-types scripts/test-firestore-v2-runtime.mjs",
    "check:pro": "node scripts/check-pro-config.mjs && node scripts/check-pro-support.mjs",
    "test:pro:runtime": "node --experimental-strip-types scripts/test-v2-pro-runtime.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "miniflare": "^5.20261006.2-beta",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "dexie": "4.4.6",
    "jspdf": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
