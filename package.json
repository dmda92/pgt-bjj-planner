  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "miniflare": "^5.20261006.2-beta",
    "typescript": "^5.9.3",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
