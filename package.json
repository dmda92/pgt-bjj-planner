{
  "name": "pgt-bjj-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node scripts/test-runtime.mjs",
